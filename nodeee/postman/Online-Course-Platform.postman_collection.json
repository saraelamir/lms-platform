{
  "info": {
    "name": "Online Course Platform API",
    "description": "REST API for courses, lessons, enrollments, comments, ratings, and progress.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "lessonId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Instructor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Instructor\",\n  \"email\": \"instructor@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Instructor\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Student\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses?page=1&limit=10&search=&category="
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Node.js Masterclass\",\n  \"description\": \"Learn backend development\",\n  \"category\": \"Backend\"\n}"
            },
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Node.js Masterclass (updated)\"\n}"
            },
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Get Rating Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "disabled": true }],
            "url": "{{baseUrl}}/api/courses/{{courseId}}/ratings"
          }
        },
        {
          "name": "Rate Course (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"value\": 5\n}" },
            "url": "{{baseUrl}}/api/courses/{{courseId}}/ratings"
          }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
        {
          "name": "Create Lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction\",\n  \"content\": \"Welcome to the course.\"\n}"
            },
            "url": "{{baseUrl}}/api/courses/{{courseId}}/lessons"
          }
        },
        {
          "name": "List Lessons",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses/{{courseId}}/lessons"
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}" },
            "url": "{{baseUrl}}/api/enrollments"
          }
        },
        {
          "name": "My Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/enrollments/my-courses"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Great lesson!\"\n}" },
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/comments"
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/comments?page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Progress",
      "item": [
        {
          "name": "Update Progress",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progressPercent\": 75,\n  \"completed\": false,\n  \"lastPositionSec\": 120\n}"
            },
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/progress"
          }
        },
        {
          "name": "Get Progress",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/progress"
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
